{
	admin off
	auto_https off
}

:8080 {
	@index path / /index.html
	header @index Cache-Control "no-store"

	@assets path /assets/*
	header @assets Cache-Control "public, max-age=31536000, immutable"

	reverse_proxy 127.0.0.1:{$DSH_WEB_PORT} {
		header_up Host 127.0.0.1:{$DSH_WEB_PORT}
		header_up Origin http://127.0.0.1:{$DSH_WEB_PORT}
	}
}
